{
  "name": "hisaab",
  "version": "1.0.0",
  "description": "Hisaab - Expense Sharing & Splitting Application",
  "author": "mohityadav55199",
  "scripts": {
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm start --prefix server",
    "client": "npm run web --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
